{
	"schemaVersion": 1,
	"id": "pokeloader",
	"version": "${version}",
	"name": "Pokeloader",
	"description": "Displays the iconic Pokeball on game startup with some satisfying audio as well.",
	"authors": [
		"LittlePerson101"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/pokeloader",
		"sources": "https://github.com/LittlePerson101/pokeloader",
        "issues": "https://github.com/LittlePerson101/pokeloader/issues"
	},
  "environment": "client",
	"license": "GNU-AGPL-3.0-only",
	"icon": "assets/pokeloader/icon.png",
	"entrypoints": {
		"main": [
          "io.github.littleperson101.pokeloader.Pokeloader"
		],
		"client": [
          "io.github.littleperson101.pokeloader.client.PokeloaderClient"
		],
        "modmenu": [
          "io.github.littleperson101.pokeloader.client.integration.PokeloaderModMenu"
        ]
	},
	"mixins": [
		"pokeloader.mixins.json",
		{
			"config": "pokeloader.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
    },
    "custom": {
      "modmenu": {
        "update_checker": true
      }
    }
}

